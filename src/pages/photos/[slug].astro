---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const sets = await getCollection('photoSets');
  return sets.map((set) => ({ params: { slug: set.slug }, props: { set } }));
}

const { set } = Astro.props;
const { title, date, location, note, photos } = set.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const formatTakenAt = (d: Date) =>
  d.toLocaleString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit'
  });

// Precompute two larger versions of each photo, so the grid only ever ships
// thumbnail-sized images: a "fit the screen" size for the lightbox, and a
// bigger "zoom" size (up to the source photo's native resolution) that's
// only loaded if someone actually clicks in to inspect detail.
const lightboxPhotos = await Promise.all(
  photos.map(async (photo) => {
    const large = await getImage({ src: photo.image, width: Math.min(photo.image.width, 1800) });
    const zoom = await getImage({ src: photo.image, width: Math.min(photo.image.width, 3200) });
    return {
      src: large.src,
      width: large.attributes.width,
      height: large.attributes.height,
      zoomSrc: zoom.src,
      zoomWidth: zoom.attributes.width,
      zoomHeight: zoom.attributes.height,
      title: photo.title ?? '',
      takenAt: photo.takenAt ? formatTakenAt(photo.takenAt) : ''
    };
  })
);

// Escape "<" so a title/caption containing "</script>" can't break out of
// the embedded JSON data island below.
const lightboxJson = JSON.stringify(lightboxPhotos).replace(/</g, '\\u003c');
---

<Layout title={`${title} | Photos`} description={note ?? `Photo set from ${location ?? 'the archive'}.`}>
  <article class="hero hero-surface">
    <p class="eyebrow">Photo Set</p>
    <h1>{title}</h1>
    {note && <p class="lead">{note}</p>}
    <div class="meta-row">
      <span class="badge">{formatDate(date)}</span>
      {location && <span class="badge">{location}</span>}
      <span class="badge">{photos.length} photo{photos.length === 1 ? '' : 's'}</span>
    </div>
    <div class="btn-row">
      <a class="btn btn-secondary" href="/photos">All photo sets</a>
    </div>
  </article>

  <section class="section-title photo-gallery">
    {photos.map((photo, i) => (
      <button type="button" class="photo-gallery-item" data-index={i} aria-label={`View ${photo.title || `photo ${i + 1}`} larger`}>
        <Image src={photo.image} alt={photo.title || `${title} — photo ${i + 1}`} width={640} />
        {photo.title && <span class="photo-caption">{photo.title}</span>}
      </button>
    ))}
  </section>

  <div id="lightbox" class="lightbox-overlay" aria-hidden="true">
    <button type="button" id="lightboxClose" class="lightbox-close" aria-label="Close">✕</button>
    {photos.length > 1 && (
      <>
        <button type="button" id="lightboxPrev" class="lightbox-nav lightbox-prev" aria-label="Previous photo">‹</button>
        <button type="button" id="lightboxNext" class="lightbox-nav lightbox-next" aria-label="Next photo">›</button>
      </>
    )}
    <figure class="lightbox-figure">
      <div id="lightboxImageWrap" class="lightbox-image-wrap">
        <img id="lightboxImg" src="" alt="" />
      </div>
      <figcaption id="lightboxCaption"></figcaption>
    </figure>
  </div>

  <script type="application/json" id="photo-gallery-data" set:html={lightboxJson} />
</Layout>

<style>
  /* CSS Grid rows size to the tallest item in the row, which left dead
     space under shorter photos whenever a row mixed portrait/landscape
     shots. A CSS multi-column ("masonry") layout instead packs each
     column top-to-bottom independently, so the gap stays the ~1.25rem set
     below in every direction regardless of a photo's aspect ratio. */
  .photo-gallery {
    columns: 4 280px;
    column-gap: 1.25rem;
  }

  .photo-gallery-item {
    width: 100%;
    margin: 0 0 1.25rem;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    display: flex;
    flex-direction: column;
    font: inherit;
    color: inherit;
    text-align: left;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }

  .photo-gallery-item :global(img) {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .photo-gallery-item:hover :global(img),
  .photo-gallery-item:focus-visible :global(img) {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--accent), transparent 78%);
  }

  .photo-caption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
  }

  .lightbox-overlay.is-open {
    display: flex;
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(1400px, 92vw);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Fit mode: image is scaled down to fit the viewport, click to zoom in. */
  .lightbox-image-wrap {
    max-width: 100%;
    max-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 12px;
  }

  .lightbox-image-wrap img {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    border-radius: 12px;
    display: block;
    cursor: zoom-in;
  }

  /* Zoom mode: image renders at its (larger) native size and the wrap
     becomes a scroll/pan container instead of a fit-to-screen box. */
  .lightbox-image-wrap.is-zoomed {
    max-width: min(1400px, 92vw);
    display: block;
    overflow: auto;
    cursor: grab;
  }

  .lightbox-image-wrap.is-zoomed img {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }

  .lightbox-figure figcaption {
    margin-top: 0.9rem;
    color: var(--text);
    font-size: 0.95rem;
    text-align: center;
  }

  .lightbox-figure figcaption:empty {
    display: none;
  }

  .lightbox-close,
  .lightbox-nav {
    position: fixed;
    background: color-mix(in srgb, var(--bg-soft), transparent 10%);
    border: 1px solid color-mix(in srgb, var(--muted), transparent 60%);
    color: var(--text);
    border-radius: 999px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    border-color: color-mix(in srgb, var(--accent), transparent 40%);
    color: var(--accent);
  }

  .lightbox-close {
    top: 1.25rem;
    right: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.1rem;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    font-size: 1.8rem;
  }

  .lightbox-prev {
    left: 1.25rem;
  }

  .lightbox-next {
    right: 1.25rem;
  }

  @media (max-width: 640px) {
    .lightbox-overlay {
      padding: 1rem;
    }

    .lightbox-nav {
      width: 2.4rem;
      height: 2.4rem;
      font-size: 1.4rem;
    }
  }
</style>

<script is:inline>
  (function () {
    const dataEl = document.getElementById('photo-gallery-data');
    const overlay = document.getElementById('lightbox');
    if (!dataEl || !overlay) return;

    const photos = JSON.parse(dataEl.textContent || '[]');
    const wrap = document.getElementById('lightboxImageWrap');
    const imgEl = document.getElementById('lightboxImg');
    const captionEl = document.getElementById('lightboxCaption');
    const closeBtn = document.getElementById('lightboxClose');
    const prevBtn = document.getElementById('lightboxPrev');
    const nextBtn = document.getElementById('lightboxNext');
    let currentIndex = 0;
    let lastFocused = null;
    let isZoomed = false;
    let isDragging = false;
    let dragMoved = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let scrollStartX = 0;
    let scrollStartY = 0;

    function setZoomed(zoomed) {
      isZoomed = zoomed;
      wrap.classList.toggle('is-zoomed', zoomed);
    }

    function render() {
      const photo = photos[currentIndex];
      if (!photo) return;
      setZoomed(false);
      imgEl.src = photo.src;
      imgEl.width = photo.width;
      imgEl.height = photo.height;
      imgEl.alt = photo.title || '';
      captionEl.textContent = [photo.title, photo.takenAt].filter(Boolean).join(' — ');
    }

    // Zooms toward the point that was clicked: measures the click position
    // against the currently-shown (fit-to-screen) image, then scrolls the
    // larger zoomed-in image so that same point stays centered.
    function zoomIn(clientX, clientY) {
      const photo = photos[currentIndex];
      if (!photo || !photo.zoomSrc || photo.zoomSrc === photo.src) return;

      const rect = imgEl.getBoundingClientRect();
      const fracX = (clientX - rect.left) / rect.width;
      const fracY = (clientY - rect.top) / rect.height;

      imgEl.src = photo.zoomSrc;
      imgEl.width = photo.zoomWidth;
      imgEl.height = photo.zoomHeight;
      setZoomed(true);

      requestAnimationFrame(() => {
        wrap.scrollLeft = Math.max(0, fracX * wrap.scrollWidth - wrap.clientWidth / 2);
        wrap.scrollTop = Math.max(0, fracY * wrap.scrollHeight - wrap.clientHeight / 2);
      });
    }

    function zoomOut() {
      const photo = photos[currentIndex];
      if (!photo) return;
      imgEl.src = photo.src;
      imgEl.width = photo.width;
      imgEl.height = photo.height;
      setZoomed(false);
    }

    function open(index) {
      currentIndex = index;
      lastFocused = document.activeElement;
      render();
      overlay.classList.add('is-open');
      overlay.removeAttribute('aria-hidden');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function next() {
      currentIndex = (currentIndex + 1) % photos.length;
      render();
    }

    function prev() {
      currentIndex = (currentIndex - 1 + photos.length) % photos.length;
      render();
    }

    document.querySelectorAll('.photo-gallery-item').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index)));
    });

    imgEl.addEventListener('click', (e) => {
      // A drag-to-pan gesture also fires a click on release — swallow that
      // one click so dragging doesn't immediately zoom back out.
      if (dragMoved) {
        dragMoved = false;
        return;
      }
      if (isZoomed) {
        zoomOut();
      } else {
        zoomIn(e.clientX, e.clientY);
      }
    });

    // Mouse drag-to-pan while zoomed. Touch devices already get native
    // scroll/pan on the overflow:auto wrap, so this only engages for mice.
    wrap.addEventListener('pointerdown', (e) => {
      if (!isZoomed || e.pointerType !== 'mouse') return;
      isDragging = true;
      dragMoved = false;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      scrollStartX = wrap.scrollLeft;
      scrollStartY = wrap.scrollTop;
      wrap.setPointerCapture(e.pointerId);
      wrap.style.cursor = 'grabbing';
    });

    wrap.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      const dy = e.clientY - dragStartY;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragMoved = true;
      wrap.scrollLeft = scrollStartX - dx;
      wrap.scrollTop = scrollStartY - dy;
    });

    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      wrap.style.cursor = '';
    }
    wrap.addEventListener('pointerup', endDrag);
    wrap.addEventListener('pointerleave', endDrag);

    closeBtn.addEventListener('click', close);
    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });
  })();
</script>
