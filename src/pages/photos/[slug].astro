---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const sets = await getCollection('photoSets');
  return sets.map((set) => ({ params: { slug: set.slug }, props: { set } }));
}

const { set } = Astro.props;
const { title, date, location, note, cover, images } = set.data;
---

<Layout title={`${title} | Photos`} description={note ?? `Photo set from ${location ?? 'the archive'}.`}>
  <article class="hero hero-surface">
    <p class="eyebrow">Photo Set</p>
    <h1>{title}</h1>
    {note && <p class="lead">{note}</p>}
    <div class="meta-row">
      <span class="badge">{date.toISOString().slice(0, 10)}</span>
      {location && <span class="badge">{location}</span>}
      <span class="badge">{images.length} photo{images.length === 1 ? '' : 's'}</span>
    </div>
    <div class="btn-row">
      <a class="btn btn-secondary" href="/photos">All photo sets</a>
    </div>
  </article>

  <section class="section-title">
    <Image
      class="photo-set-hero-cover"
      src={cover}
      alt={title}
      width={1400}
      height={840}
      priority
    />
  </section>

  {images.length > 0 && (
    <section class="section-title photo-gallery">
      {images.map((photo) => (
        <figure class="photo-gallery-item">
          <Image src={photo.src} alt={photo.alt} width={900} />
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      ))}
    </section>
  )}
</Layout>

<style>
  .photo-set-hero-cover {
    width: 100%;
    max-height: 70vh;
    object-fit: cover;
    border-radius: 16px;
    background: var(--bg-soft);
  }

  .photo-gallery {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .photo-gallery-item {
    margin: 0;
  }

  .photo-gallery-item :global(img) {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
  }

  .photo-gallery-item figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
