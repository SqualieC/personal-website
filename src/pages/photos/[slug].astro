---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { load as loadYaml } from 'js-yaml';
import exifr from 'exifr';

export async function getStaticPaths() {
  const sets = await getCollection('photoSets');
  return sets.map((set) => ({ params: { slug: set.slug }, props: { set } }));
}

const { set } = Astro.props;
const { title, date, location, note, photos } = set.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const formatTakenAt = (d: Date) =>
  d.toLocaleString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit'
  });

// Astro's image() schema helper resolves each photo to just {src, width,
// height, format} — it deliberately doesn't expose the original file's
// path. To read a photo's real EXIF capture date, independently re-read
// this entry's own raw frontmatter (the one place we still have the
// original "../../assets/photo-sets/<file>" path string) and resolve each
// photo back to its actual file on disk.
//
// process.cwd() rather than import.meta.url-relative pathing: at build
// time this page module gets bundled into dist/chunks/, so import.meta.url
// there resolves relative to the *output* location, not the source file —
// process.cwd() is the project root regardless of how the page is bundled.
const CONTENT_DIR = path.join(process.cwd(), 'src', 'content', 'photoSets');
const rawFrontmatter = readFileSync(path.join(CONTENT_DIR, `${set.slug}.mdx`), 'utf-8');
const frontmatterMatch = rawFrontmatter.match(/^---\n([\s\S]*?)\n---/);
const rawPhotos = (frontmatterMatch ? loadYaml(frontmatterMatch[1]) : {})?.photos ?? [];

const exifTakenAt = await Promise.all(
  rawPhotos.map(async (raw: { image?: string }) => {
    if (!raw?.image) return null;
    try {
      const absPath = path.resolve(CONTENT_DIR, raw.image);
      const exif = await exifr.parse(absPath, ['DateTimeOriginal', 'CreateDate']);
      const captured = exif?.DateTimeOriginal ?? exif?.CreateDate;
      return captured instanceof Date ? captured : null;
    } catch {
      return null; // no EXIF, unsupported format, or unreadable — just skip it
    }
  })
);

// Precompute a larger version of each photo for the lightbox, so the grid
// only ever ships thumbnail-sized images. A manually-set takenAt in the CMS
// always wins (e.g. for scans with no EXIF, or to correct a wrong camera
// clock); otherwise fall back to the photo file's own EXIF capture time.
const lightboxPhotos = await Promise.all(
  photos.map(async (photo, i) => {
    const large = await getImage({ src: photo.image, width: Math.min(photo.image.width, 1800) });
    const takenAt = photo.takenAt ?? exifTakenAt[i] ?? null;
    return {
      src: large.src,
      width: large.attributes.width,
      height: large.attributes.height,
      title: photo.title ?? '',
      takenAt: takenAt ? formatTakenAt(takenAt) : ''
    };
  })
);

// Escape "<" so a title/caption containing "</script>" can't break out of
// the embedded JSON data island below.
const lightboxJson = JSON.stringify(lightboxPhotos).replace(/</g, '\\u003c');
---

<Layout title={`${title} | Photos`} description={note ?? `Photo set from ${location ?? 'the archive'}.`}>
  <article class="hero hero-surface">
    <p class="eyebrow">Photo Set</p>
    <h1>{title}</h1>
    {note && <p class="lead">{note}</p>}
    <div class="meta-row">
      <span class="badge">{formatDate(date)}</span>
      {location && <span class="badge">{location}</span>}
      <span class="badge">{photos.length} photo{photos.length === 1 ? '' : 's'}</span>
    </div>
    <div class="btn-row">
      <a class="btn btn-secondary" href="/photos">All photo sets</a>
    </div>
  </article>

  <section class="section-title photo-gallery">
    {photos.map((photo, i) => (
      <button type="button" class="photo-gallery-item" data-index={i} aria-label={`View ${photo.title || `photo ${i + 1}`} larger`}>
        <Image src={photo.image} alt={photo.title || `${title} — photo ${i + 1}`} width={640} draggable="false" />
        {photo.title && <span class="photo-caption">{photo.title}</span>}
      </button>
    ))}
  </section>

  <div id="lightbox" class="lightbox-overlay" aria-hidden="true">
    <button type="button" id="lightboxClose" class="lightbox-close" aria-label="Close">✕</button>
    {photos.length > 1 && (
      <>
        <button type="button" id="lightboxPrev" class="lightbox-nav lightbox-prev" aria-label="Previous photo">‹</button>
        <button type="button" id="lightboxNext" class="lightbox-nav lightbox-next" aria-label="Next photo">›</button>
      </>
    )}
    <figure class="lightbox-figure">
      <div id="lightboxImageWrap" class="lightbox-image-wrap">
        <img id="lightboxImg" src="" alt="" draggable="false" />
      </div>
      <figcaption id="lightboxCaption"></figcaption>
    </figure>
  </div>

  <script type="application/json" id="photo-gallery-data" set:html={lightboxJson} />
</Layout>

<style>
  /* CSS Grid rows size to the tallest item in the row, which left dead
     space under shorter photos whenever a row mixed portrait/landscape
     shots. A CSS multi-column ("masonry") layout instead packs each
     column top-to-bottom independently, so the gap stays the ~1.25rem set
     below in every direction regardless of a photo's aspect ratio. */
  .photo-gallery {
    columns: 4 280px;
    column-gap: 1.25rem;
  }

  .photo-gallery-item {
    width: 100%;
    margin: 0 0 1.25rem;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    display: flex;
    flex-direction: column;
    font: inherit;
    color: inherit;
    text-align: left;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }

  /* draggable="false" (in the markup) covers the standard HTML5 drag; these
     cover the gaps it doesn't: Safari's own drag-out gesture and iOS's
     long-press "save/copy image" callout. None of this is real protection
     — the file still has to reach the browser to display it — it just
     removes the casual/easy path. */
  .photo-gallery-item :global(img),
  .lightbox-image-wrap img {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }

  .photo-gallery-item :global(img) {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .photo-gallery-item:hover :global(img),
  .photo-gallery-item:focus-visible :global(img) {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--accent), transparent 78%);
  }

  .photo-caption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
  }

  .lightbox-overlay.is-open {
    display: flex;
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(1400px, 92vw);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* overflow: hidden here means zooming can never produce scrollbars —
     content that scales past the box edge is simply clipped, not scrolled. */
  .lightbox-image-wrap {
    max-width: 100%;
    max-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 12px;
  }

  .lightbox-image-wrap img {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    border-radius: 12px;
    display: block;
    cursor: zoom-in;
    transition: transform 180ms ease;
  }

  /* The actual scale/translate values are set from JS via inline style
     (translate carries the pan offset, which changes continuously while
     dragging — a static class rule can't express that). This class only
     needs to override the cursor; is-dragging additionally drops the
     transition so panning tracks the pointer with no easing lag. */
  .lightbox-image-wrap img.is-zoomed {
    cursor: grab;
    touch-action: none;
  }

  .lightbox-image-wrap img.is-zoomed.is-dragging {
    cursor: grabbing;
    transition: none;
  }

  .lightbox-figure figcaption {
    margin-top: 0.9rem;
    color: var(--text);
    font-size: 0.95rem;
    text-align: center;
  }

  .lightbox-figure figcaption:empty {
    display: none;
  }

  .lightbox-close,
  .lightbox-nav {
    position: fixed;
    background: color-mix(in srgb, var(--bg-soft), transparent 10%);
    border: 1px solid color-mix(in srgb, var(--muted), transparent 60%);
    color: var(--text);
    border-radius: 999px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    border-color: color-mix(in srgb, var(--accent), transparent 40%);
    color: var(--accent);
  }

  .lightbox-close {
    top: 1.25rem;
    right: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.1rem;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    font-size: 1.8rem;
  }

  .lightbox-prev {
    left: 1.25rem;
  }

  .lightbox-next {
    right: 1.25rem;
  }

  @media (max-width: 640px) {
    .lightbox-overlay {
      padding: 1rem;
    }

    .lightbox-nav {
      width: 2.4rem;
      height: 2.4rem;
      font-size: 1.4rem;
    }
  }
</style>

<script is:inline>
  (function () {
    const dataEl = document.getElementById('photo-gallery-data');
    const overlay = document.getElementById('lightbox');
    if (!dataEl || !overlay) return;

    const photos = JSON.parse(dataEl.textContent || '[]');
    const wrap = document.getElementById('lightboxImageWrap');
    const imgEl = document.getElementById('lightboxImg');
    const captionEl = document.getElementById('lightboxCaption');
    const closeBtn = document.getElementById('lightboxClose');
    const prevBtn = document.getElementById('lightboxPrev');
    const nextBtn = document.getElementById('lightboxNext');
    const ZOOM_SCALE = 2;
    let currentIndex = 0;
    let lastFocused = null;
    let isZoomed = false;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let dragMoved = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let panStartX = 0;
    let panStartY = 0;

    function applyTransform() {
      imgEl.style.transform = isZoomed ? `translate(${panX}px, ${panY}px) scale(${ZOOM_SCALE})` : '';
    }

    // Keeps a drag from throwing the image far outside the frame — clamps
    // to a generous but bounded range relative to the frame's own size
    // rather than computing exact scaled-image edges.
    function clampPan() {
      const maxPanX = wrap.clientWidth * 0.5;
      const maxPanY = wrap.clientHeight * 0.5;
      panX = Math.max(-maxPanX, Math.min(maxPanX, panX));
      panY = Math.max(-maxPanY, Math.min(maxPanY, panY));
    }

    function setZoomed(zoomed) {
      isZoomed = zoomed;
      panX = 0;
      panY = 0;
      imgEl.classList.toggle('is-zoomed', zoomed);
      applyTransform();
    }

    function render() {
      const photo = photos[currentIndex];
      if (!photo) return;
      setZoomed(false);
      imgEl.src = photo.src;
      imgEl.width = photo.width;
      imgEl.height = photo.height;
      imgEl.alt = photo.title || '';
      captionEl.textContent = [photo.title, photo.takenAt].filter(Boolean).join(' — ');
    }

    // Anchors the zoom at the exact point clicked: transform-origin is set
    // to that point (as a % of the image box) before scale() is applied, so
    // the clicked spot stays fixed in place while everything around it
    // grows — a plain CSS transform, so there's no scroll math or layout
    // race to get wrong.
    function zoomInAt(clientX, clientY) {
      const rect = imgEl.getBoundingClientRect();
      const fracX = ((clientX - rect.left) / rect.width) * 100;
      const fracY = ((clientY - rect.top) / rect.height) * 100;
      imgEl.style.transformOrigin = `${fracX}% ${fracY}%`;
      setZoomed(true);
    }

    // Mouse AND touch (Pointer Events unify both): while zoomed, dragging
    // pans the image via translate() instead of native scroll (there's
    // nothing to scroll — the wrap is overflow: hidden). A drag's trailing
    // click is swallowed via dragMoved so it doesn't also zoom back out.
    imgEl.addEventListener('pointerdown', (e) => {
      if (!isZoomed) return;
      isDragging = true;
      dragMoved = false;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      panStartX = panX;
      panStartY = panY;
      imgEl.setPointerCapture(e.pointerId);
      imgEl.classList.add('is-dragging');
    });

    imgEl.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      const dy = e.clientY - dragStartY;
      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) dragMoved = true;
      panX = panStartX + dx;
      panY = panStartY + dy;
      clampPan();
      applyTransform();
    });

    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      imgEl.classList.remove('is-dragging');
    }
    imgEl.addEventListener('pointerup', endDrag);
    imgEl.addEventListener('pointercancel', endDrag);

    function open(index) {
      currentIndex = index;
      lastFocused = document.activeElement;
      render();
      overlay.classList.add('is-open');
      overlay.removeAttribute('aria-hidden');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function next() {
      currentIndex = (currentIndex + 1) % photos.length;
      render();
    }

    function prev() {
      currentIndex = (currentIndex - 1 + photos.length) % photos.length;
      render();
    }

    document.querySelectorAll('.photo-gallery-item').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index)));
    });

    // draggable="false" in the markup covers the common case; this is a
    // backstop for browsers/situations where a drag still starts anyway
    // (it was also fighting the pan-drag handlers above — the native image
    // drag and our pointer-based pan were competing for the same gesture).
    // Also drops the right-click "Save image as / Open image in new tab"
    // menu on the photos specifically, without touching the rest of the page.
    document.querySelectorAll('.photo-gallery-item img').forEach((el) => {
      el.addEventListener('dragstart', (e) => e.preventDefault());
      el.addEventListener('contextmenu', (e) => e.preventDefault());
    });
    imgEl.addEventListener('dragstart', (e) => e.preventDefault());
    imgEl.addEventListener('contextmenu', (e) => e.preventDefault());

    imgEl.addEventListener('click', (e) => {
      // A drag-to-pan gesture also fires a trailing click on release —
      // swallow that one so dragging doesn't immediately zoom back out.
      if (dragMoved) {
        dragMoved = false;
        return;
      }
      if (isZoomed) {
        setZoomed(false);
      } else {
        zoomInAt(e.clientX, e.clientY);
      }
    });

    closeBtn.addEventListener('click', close);
    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });
  })();
</script>
