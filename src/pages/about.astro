---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const about = await getEntry('about', 'about');
const { Content } = await render(about!);
const { title, tagline, photo, updatedAt } = about!.data;
---

<Layout title={`${title} | SqualieC`} description={tagline}>
  <article class="hero hero-surface">
    <p class="eyebrow">About</p>
    <h1>{title}</h1>
    {tagline && <p class="lead">{tagline}</p>}
    {updatedAt && (
      <div class="meta-row">
        <span class="badge">Updated {updatedAt.toISOString().slice(0, 10)}</span>
      </div>
    )}
  </article>

  <section class={photo ? 'detail-grid section-title' : 'section-title'}>
    <article class="prose card">
      <Content />
    </article>

    {photo && (
      <aside class="detail-side">
        <Image src={photo} alt={title} width={480} />
      </aside>
    )}
  </section>
</Layout>
